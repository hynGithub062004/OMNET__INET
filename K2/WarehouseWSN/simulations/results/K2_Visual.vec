config output-scalar-file results/K2_Visual.sca
config output-vector-file results/K2_Visual.vec
config *.visualizer.mediumVisualizer.displaySignals true
config *.visualizer.physicalLinkVisualizer.displayLinks true
config *.visualizer.physicalLinkVisualizer.packetFilter "\"SensorData*\""
config *.visualizer.energyStorageVisualizer.displayEnergyStorages true
config *.gateway.wlan[0].radio.displayCommunicationRange true
config description "K2 base configuration with 30 sensors and one corner gateway"
