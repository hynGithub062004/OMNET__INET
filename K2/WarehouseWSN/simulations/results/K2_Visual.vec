config *.gateway.wlan[0].radio.receiver.ignoreInterference false
config *.sensor[*].wlan[0].mac.typename CsmaCaMac
config *.gateway.wlan[0].mac.typename CsmaCaMac
config *.sensor[*].wlan[0].mac.useAck true
config *.gateway.wlan[0].mac.useAck true
config *.sensor[*].wlan[0].mac.ackTimeout 300us
config *.gateway.wlan[0].mac.ackTimeout 300us
config *.sensor[*].wlan[0].mac.headerLength 23B
config *.gateway.wlan[0].mac.headerLength 23B
config *.sensor[*].wlan[0].queue.typename DropTailQueue
config *.gateway.wlan[0].queue.typename DropTailQueue
config *.sensor[*].wlan[0].queue.packetCapacity 50
config *.gateway.wlan[0].queue.packetCapacity 50
config *.sensor[*].wlan[0].mac.bitrate 1Mbps
config *.gateway.wlan[0].mac.bitrate 1Mbps
config *.sensor[*].wlan[0].radio.transmitter.bitrate 1Mbps
config *.gateway.wlan[0].radio.transmitter.bitrate 1Mbps
config *.sensor[*].hasStatus true
config *.sensor[*].energyStorage.typename SimpleEpEnergyStorage
config *.sensor[*].energyStorage.nominalCapacity 100J
config *.sensor[*].energyStorage.initialCapacity 100J
config *.sensor[*].energyStorage.printCapacityStep 0.001J
config *.sensor[*].wlan[0].radio.energyConsumer.typename SensorStateBasedEpEnergyConsumer
config *.sensor[*].app[0].packetSent.result-recording-modes count
config *.gateway.app[0].packetReceived.result-recording-modes count
config *.gateway.app[0].endToEndDelay.result-recording-modes vector,stats
config *.sensor[*].energyStorage.residualEnergyCapacity.result-recording-modes vector,last
